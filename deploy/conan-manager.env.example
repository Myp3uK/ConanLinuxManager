# Keep this file owned by root and mode 0600.
CONAN_MANAGER_LISTEN=127.0.0.1:8080
CONAN_MANAGER_DATABASE=/var/lib/conan-manager/manager.db

# Until session authentication is implemented, protect the API behind HTTPS
# and set these values. Empty values leave only the reverse proxy as protection.
CONAN_MANAGER_ADMIN_USERNAME=admin
CONAN_MANAGER_ADMIN_PASSWORD=change-me

# Master key for encrypted backup secrets. This value is not stored in SQLite.
CONAN_MANAGER_SECRET_KEY=replace-with-a-long-random-value

# Query availability: observation only, never triggers a restart.
# QueryPort comes from the server configuration and must match actual launch args.
CONAN_MANAGER_QUERY_HOST=127.0.0.1
CONAN_MANAGER_QUERY_INTERVAL=15s
CONAN_MANAGER_QUERY_TIMEOUT=3s
CONAN_MANAGER_QUERY_STARTUP_GRACE=10m
CONAN_MANAGER_QUERY_UNAVAILABLE_FOR=5m
