# Keep this file owned by root and mode 0600.
CONAN_MANAGER_LISTEN=127.0.0.1:8080
CONAN_MANAGER_DATABASE=/var/lib/conan-manager/manager.db

# Protect the API behind HTTPS and set these values.
CONAN_MANAGER_ADMIN_USERNAME=admin
CONAN_MANAGER_ADMIN_PASSWORD=change-me
# Optional public origin when running behind a reverse proxy, e.g.
# CONAN_MANAGER_ALLOWED_ORIGIN=https://manager.example.com

# Keep this many newest Conan backup files per Saved tree.
CONAN_MANAGER_BACKUP_RETENTION=10

# The manager's own world backups (POST /servers/{id}/backup, and one before
# every update): one directory per server, kept apart from the game's rotation.
# It may be on another disk; /home is not reachable (ProtectHome).
CONAN_MANAGER_BACKUP_DIR=/var/lib/conan-manager/backups
# Newest manager backups kept per server; 0 keeps all.
CONAN_MANAGER_BACKUP_KEEP=20

# Master key for encrypted backup target secrets. Not stored in SQLite.
CONAN_MANAGER_SECRET_KEY=replace-with-a-long-random-value

# Return internal error text to API clients. Those messages contain absolute
# server paths, so this is off unless a deployment needs it for debugging.
# CONAN_MANAGER_EXPOSE_ERROR_DETAIL=false

# Run each game server as a conan-server@ID systemd unit. Servers then keep
# running while the manager restarts or is upgraded. Needs
# deploy/conan-server@.service and deploy/50-conan-manager.rules installed.
CONAN_MANAGER_SERVER_UNITS=true
# Launch specifications the units read.
# CONAN_MANAGER_UNIT_DIR=/var/lib/conan-manager/units

# A stop sends SIGTERM and waits this long for the world to be saved before the
# game is killed and its database checked. Raising it past 6m also needs
# TimeoutStopSec raised in conan-server@.service.
CONAN_MANAGER_STOP_TIMEOUT=5m

# Operator scripts run around lifecycle events. The directory and every script
# must be owned by root and not writable by others.
CONAN_MANAGER_HOOKS_DIR=/etc/conan-manager/hooks
CONAN_MANAGER_HOOK_TIMEOUT=5m

# Outgoing notifications go through this proxy when set: http://, https:// or
# socks5://user:password@host:port. Needed where Discord is blocked.
# CONAN_MANAGER_NOTIFY_PROXY=socks5://127.0.0.1:1080

# How often Steam is asked for a newer server build; "off" disables. Minimum 5m.
CONAN_MANAGER_UPDATE_CHECK_INTERVAL=30m

# Enable the systemd launcher for specific server IDs (see deploy/LAUNCHER.md).
# CONAN_MANAGER_LAUNCHER_IDS=ue5-test

# Query availability: observation only, never triggers a restart.
# QueryPort comes from the server configuration and must match actual launch args.
CONAN_MANAGER_QUERY_HOST=127.0.0.1
CONAN_MANAGER_QUERY_INTERVAL=15s
CONAN_MANAGER_QUERY_TIMEOUT=3s
CONAN_MANAGER_QUERY_STARTUP_GRACE=10m
CONAN_MANAGER_QUERY_UNAVAILABLE_FOR=5m
