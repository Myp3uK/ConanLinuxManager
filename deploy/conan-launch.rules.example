// Install as /etc/polkit-1/rules.d/50-conan-launch.rules, root:root 0644.
// Replace the explicit unit allowlist with your provisioned server IDs.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "conan-manager" &&
        ["conan-launch@test.service"].indexOf(action.lookup("unit")) !== -1 &&
        ["start", "stop"].indexOf(action.lookup("verb")) !== -1) {
        return polkit.Result.YES;
    }
});
