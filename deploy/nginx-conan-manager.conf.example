# HTTPS in front of the manager. The manager listens on 127.0.0.1:8080 and
# believes the forwarded client address only from this proxy:
#
#   CONAN_MANAGER_LISTEN=127.0.0.1:8080
#   CONAN_MANAGER_TRUSTED_PROXIES=127.0.0.1
#   CONAN_MANAGER_ALLOWED_ORIGIN=https://manager.example.com
#
# Certificates: certbot --nginx -d manager.example.com, or your own.
# Install: /etc/nginx/sites-available/conan-manager, link it into
# sites-enabled, nginx -t && systemctl reload nginx.

server {
    listen 80;
    listen [::]:80;
    server_name manager.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name manager.example.com;

    ssl_certificate     /etc/letsencrypt/live/manager.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/manager.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Config uploads and restores are small; the manager caps bodies at 1 MB.
    client_max_body_size 2m;

    # Optionally keep the panel away from everyone else already here; the
    # manager's own CONAN_MANAGER_ALLOWED_IPS does the same one step later.
    # allow 203.0.113.10;
    # deny all;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replace, not append: whatever the client sent is not trusted.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long jobs (install, restore) are polled, not held open; logs are
        # read in pages. Default timeouts are enough.
    }
}
