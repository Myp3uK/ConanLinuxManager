[Unit]
Description=Conan Exiles Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conan-manager
Group=conan-manager
EnvironmentFile=-/etc/conan-manager/conan-manager.env
ExecStart=/opt/conan-manager/conan-manager
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
KillMode=mixed
TimeoutStopSec=870
# /run is a tmpfs: without RuntimeDirectory the manager's runtime directory is
# gone after a reboot and nothing recreates it. Preserve keeps it, and the RAM
# mounts inside it, across a manager restart.
RuntimeDirectory=conan-manager
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# Files the manager creates (database, backups, unit specifications) are
# not readable by other users.
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/conan-manager /run/conan-manager

[Install]
WantedBy=multi-user.target
